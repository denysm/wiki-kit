#!/bin/sh
# Block a push that carries data: forbidden paths, private names, secrets or
# internal hosts in the pushed tree or in any commit the remote does not have yet
# (scripts/leak_check.py). Emergency bypass, owner only: git push --no-verify.
root=$(git rev-parse --show-toplevel)
remote="$1"
. "$root/hooks/lib.sh"
if [ -z "$py" ]; then
  echo "pre-push: no Python 3.9+ found (python3, python or py -3), so the leak check cannot run; nothing was pushed." >&2
  exit 1
fi
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # deleting a branch carries nothing
  if [ "$remote_sha" = "$zero" ]; then              # new branch: everything not on this remote
    bases=$(git for-each-ref --format='--base=%(objectname)' "refs/remotes/$remote")
  else
    bases="--base=$remote_sha"
  fi
  # shellcheck disable=SC2086
  # shellcheck disable=SC2086
  $py -I "$root/scripts/leak_check.py" --repo "$root" --rev "$local_sha" --history $bases || status=1
done
if [ "$status" -ne 0 ]; then
  echo "pre-push: leak check failed, nothing was pushed. Fix the commits (or list a false positive in .leak-allow)." >&2
fi
exit $status
